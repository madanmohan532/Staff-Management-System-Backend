    @Test
    void testGetUserByEmail_found() throws Exception {
        User user = createSampleUser();
        when(userService.findByEmail("user1@example.com")).thenReturn(user);

        mockMvc.perform(get("/api/admin/admin/user/user1@example.com"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.email").value("user1@example.com"))
                .andExpect(jsonPath("$.role").value("USER"));
    }

    @Test
    void testGetUserByEmail_notFound() throws Exception {
