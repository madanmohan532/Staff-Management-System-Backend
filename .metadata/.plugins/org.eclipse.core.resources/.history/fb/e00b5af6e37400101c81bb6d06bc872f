    // --- Utility method to build a sample Admin ---
    private Admin createSampleAdmin() {
        Admin admin = new Admin();
        admin.setId("A1");
        admin.setFirstName("John");
        admin.setLastName("Doe");
        admin.setUniqueVerificationId("UV123");
        admin.setPassword("secret123");

        Admin.ContactDetails contactDetails = new Admin.ContactDetails();
        contactDetails.setEmail("admin@example.com");
        contactDetails.setPhone("9876543210");
        admin.setContactDetails(contactDetails);

        Admin.Address address = new Admin.Address();
        address.setStreet("123 Main St");
        address.setCity("Bangalore");
        address.setState("KA");
        address.setPincode("560001");
        admin.setAddress(address);

        admin.setApprovedRegistrationIds(Arrays.asList("HOSP1", "NURSE1"));
        return admin;
    }

    // --- Utility method to build a sample User ---
    private User createSampleUser() {
        User user = new User();
        user.set_id("U1");
        user.setEmail("user1@example.com");
        user.setPassword("pass123");
        user.setRole("USER");
        user.setVerificationStatus("VERIFIED");
        return user;
    }

